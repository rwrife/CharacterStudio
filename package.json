{
  "name": "character-studio",
  "productName": "Character Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI character design, humanoid rigging and animation studio",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "setup:blender": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup-blender.ps1",
    "package": "npm run build && electron-packager . CharacterStudio --win32metadata.ProductName=\"Character Studio\" --platform=win32 --arch=arm64 --out=release --overwrite --no-asar --ignore=\"^/(src|tests|release|artifacts|scripts|node_modules/.cache)(/|$)\" --ignore=\"\\.zip$\""
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
