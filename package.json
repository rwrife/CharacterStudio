{
  "name": "character-studio",
  "productName": "Character Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local AI character design, humanoid rigging and animation studio",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mcp": "electron-vite dev -- --mcp",
    "start": "electron-vite preview",
    "start:mcp": "electron-vite preview -- --mcp",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:setup": "node scripts/setup-smoke.mjs",
    "test:rigging": "node --import tsx scripts/test-rigging.ts",
    "test:mcp": "npm run build && node scripts/mcp-smoke.mjs && node --import tsx scripts/generation-smoke.mjs && node scripts/provider-smoke.mjs",
    "mcp": "node scripts/mcp-client.mjs",
    "setup:blender": "node --import tsx scripts/setup-blender.ts",
    "package": "npm run build && node --import tsx scripts/package.ts",
    "package:app": "node --import tsx scripts/package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-vite": "6.0.0",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
